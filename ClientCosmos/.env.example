# Copy to .env.local for local dev. In Vercel, add these under Project Settings -> Environment Variables.
# Vite only exposes variables prefixed with VITE_, and they are bundled into the public JS.
# Never put secrets here.

# Backend base URL (no trailing slash)
VITE_API_URL=http://localhost:3000

# Firebase web config (Project settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
