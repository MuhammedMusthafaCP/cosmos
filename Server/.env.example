# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
# Render/Railway/etc. inject PORT automatically.
PORT=3000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/cosmos

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# Frontend origin(s) for CORS and Socket.IO. Comma-separate multiple. No trailing slash.
# Required in production.
CLIENT_ORIGIN=http://localhost:5173

# Public URL of THIS server. Used for the Google OAuth callback:
#   <SERVER_URL>/auth/google/callback  (add it in Google Cloud Console)
# Required in production.
SERVER_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (defaults to DEMO_KEY, which is heavily rate limited)
NASA_API_KEY=

# --- Daily sync: space news + astronomy picture of the day + cleanup ---
# News: Spaceflight News API (no key needed). Picture of the day: NASA APOD API, with the
# NASA Science APOD page as automatic fallback.
# Run in-process on a schedule. Set to false if an external cron runs `npm run jobs:daily`.
ENABLE_SCHEDULER=true
# Cron expression + timezone. Default: every day 06:30 UTC (after NASA posts the new picture).
SYNC_CRON=30 6 * * *
SYNC_TIMEZONE=UTC
# News and pictures older than this many days are deleted by the daily cleanup.
DATA_RETENTION_DAYS=60
# Days of missing pictures of the day to backfill.
APOD_BACKFILL_DAYS=14
# Run a catch-up sync at boot if the last good one is older than this many hours.
SYNC_STALE_AFTER_HOURS=26

# Optional: avatar URL given to new users
DEFAULT_PROFILE_PIC_URL=
