# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
# Render/Railway/etc. inject PORT automatically.
PORT=3000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/cosmos

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# Frontend origin(s) for CORS and Socket.IO. Comma-separate multiple. No trailing slash.
# Required in production.
CLIENT_ORIGIN=http://localhost:5173

# Public URL of THIS server. Used for the Google OAuth callback:
#   <SERVER_URL>/auth/google/callback  (add it in Google Cloud Console)
# Required in production.
SERVER_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (defaults to DEMO_KEY, which is heavily rate limited)
NASA_API_KEY=

# Optional: avatar URL given to new users
DEFAULT_PROFILE_PIC_URL=
